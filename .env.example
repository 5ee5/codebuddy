# Copy this file to .env.local and fill in real values. .env.local is ignored by Git.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Anthropic API key from https://platform.claude.com (Console > API keys).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used by Learn and Debug. Current model IDs:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase project used for sign-in (Project Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key, never the secret service_role key.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: the secret key (Project Settings > API Keys > Secret keys), used only to create
# accounts at sign-up and to let students delete their own account. It bypasses all access
# rules: keep it here only.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional: the class code students enter at /signup (at least 8 characters). Leave it
# unset to keep sign-up closed. Restart the server after changing it.
CODEBUDDY_SIGNUP_CODE=your-class-code

# Optional: emails (sign-up confirmation and "Forgot password?") sent through Resend.
# All three are needed; without them, sign-up works without confirming the email.
RESEND_API_KEY=your-resend-api-key
# The sender; its domain must be verified in Resend.
EMAIL_FROM=CodeBuddy <noreply@your-domain.example>
# The public address links in emails point to, e.g. https://codebuddy.example (no path).
CODEBUDDY_SITE_URL=https://codebuddy.example
