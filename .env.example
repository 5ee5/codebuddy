# Copy this file to .env.local and fill in real values. .env.local is ignored by Git.
# All three are server-only: never prefix them with NEXT_PUBLIC_.

# Anthropic API key from https://platform.claude.com (Console > API keys).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model used by Learn mode. Current model IDs:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-5-5

# Shared code learners must enter before Learn calls the paid API (at least 16 characters).
# Generate one with: openssl rand -base64 18
CODEBUDDY_ACCESS_CODE=replace-with-a-long-random-code
